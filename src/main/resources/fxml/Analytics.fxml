<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: #F4F7F6;"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.airline.controller.AnalyticsController">

    <VBox spacing="25.0" style="-fx-padding: 30;">

        <!-- ===== PAGE HEADER ===== -->
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Flight Analytics"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Live statistics drawn directly from the reservation database."
                       style="-fx-text-fill: #6c757d;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh"
                    onAction="#handleRefresh"
                    styleClass="secondary-button"
                    style="-fx-background-color: #E2E8F0; -fx-border-color: transparent;"/>
        </HBox>

        <!-- ===== KPI CARDS ROW ===== -->
        <HBox spacing="20">

            <!-- Total Flights -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>
                <Label text="&#9992; Total Flights"
                       style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="lblTotalFlights"
                       text="—"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="in the system"
                       style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
            </VBox>

            <!-- Total Reservations -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>
                <Label text="&#128203; Total Reservations"
                       style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="lblTotalReservations"
                       text="—"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="all time"
                       style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
            </VBox>

            <!-- Paid / Confirmed -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>
                <Label text="&#10003; Paid Bookings"
                       style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="lblPaidCount"
                       text="—"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                <Label fx:id="lblPaidPct"
                       text=""
                       style="-fx-font-size: 11px; -fx-text-fill: #28a745;"/>
            </VBox>

            <!-- Total Revenue -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                <padding><Insets top="22" right="20" bottom="22" left="20"/></padding>
                <Label text="&#128176; Total Revenue"
                       style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
                <Label fx:id="lblRevenue"
                       text="—"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1CA1F2;"/>
                <Label text="from paid bookings"
                       style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
            </VBox>

        </HBox>

        <!-- ===== CHARTS ROW ===== -->
        <HBox spacing="25">

            <!-- Pie Chart: Top Destinations -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" spacing="10">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
                <Label text="Top Arrival Destinations"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Booking count per arrival city (from reservations)."
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
                <PieChart fx:id="destinationPieChart"
                          prefHeight="300"
                          legendSide="BOTTOM"
                          VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Bar Chart: Bookings per Airline -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" spacing="10">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
                <Label text="Reservations per Airline"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Number of bookings made for each airline."
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
                <BarChart fx:id="airlineBarChart"
                          prefHeight="300"
                          legendVisible="false"
                          VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis fx:id="xAxisAirline" label="Airline"/></xAxis>
                    <yAxis><NumberAxis fx:id="yAxisAirline" label="Reservations"/></yAxis>
                </BarChart>
            </VBox>

        </HBox>

        <!-- ===== SECOND CHARTS ROW ===== -->
        <HBox spacing="25">

            <!-- Bar Chart: Seat Availability per Flight -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" spacing="10">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
                <Label text="Seat Availability by Flight"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Available vs. occupied seats per flight ID."
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
                <BarChart fx:id="seatBarChart"
                          prefHeight="260"
                          VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis fx:id="xAxisSeat" label="Flight ID"/></xAxis>
                    <yAxis><NumberAxis fx:id="yAxisSeat" label="Seats"/></yAxis>
                </BarChart>
            </VBox>

            <!-- Pie Chart: Booking Status Split -->
            <VBox styleClass="booking-card" HBox.hgrow="ALWAYS" spacing="10" prefWidth="320">
                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
                <Label text="Booking Status Breakdown"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Paid vs. Pending reservations."
                       style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>
                <PieChart fx:id="statusPieChart"
                          prefHeight="260"
                          legendSide="BOTTOM"
                          VBox.vgrow="ALWAYS"/>

                <!-- Top Route info -->
                <VBox spacing="4" style="-fx-padding: 12 0 0 0; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
                    <Label text="TOP ROUTE"
                           style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTopRoute"
                           text="—"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                    <Label fx:id="lblTopRouteCount"
                           text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #1CA1F2;"/>
                </VBox>
            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
