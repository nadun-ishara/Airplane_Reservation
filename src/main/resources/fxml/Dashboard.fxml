<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" 
      styleClass="dashboard-container" stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.airline.controller.DashboardController">
   
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label styleClass="dashboard-title" text="Flight Search &amp; Reservations" />
    </HBox>

    <!-- Search / Filter Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-bar">
        <TextField fx:id="departureSearch" prefWidth="200.0" promptText="Departure City (e.g., Colombo)" styleClass="input-field" />
        <TextField fx:id="arrivalSearch" prefWidth="200.0" promptText="Arrival City (e.g., Dubai)" styleClass="input-field" />
        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#handleSearch" styleClass="primary-button" text="Search Flights" />
        <Button mnemonicParsing="false" onAction="#handleClear" styleClass="secondary-button" text="Clear" />
    </HBox>

    <!-- The Flight Data Grid -->
    <TableView fx:id="flightTable" prefHeight="400.0" prefWidth="840.0" VBox.vgrow="ALWAYS" styleClass="table-view">
      <columns>
          <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
          <TableColumn fx:id="colAirline" prefWidth="150.0" text="Airline" />
          <TableColumn fx:id="colDeparture" prefWidth="150.0" text="Departure" />
          <TableColumn fx:id="colArrival" prefWidth="150.0" text="Arrival" />
          <TableColumn fx:id="colTime" prefWidth="130.0" text="Date &amp; Time" />
          <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price ($)" />
          <TableColumn fx:id="colSeats" prefWidth="90.0" text="Seats Left" />
      </columns>
    </TableView>

    <!-- Booking Action -->
    <HBox alignment="CENTER_RIGHT">
        <Button mnemonicParsing="false" onAction="#handleBookFlight" styleClass="success-button" text="Book Selected" />
    </HBox>

</VBox>