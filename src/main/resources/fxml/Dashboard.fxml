<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: #F4F7F6;"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.airline.controller.DashboardController">

    <VBox spacing="25.0" style="-fx-padding: 30;">

        <!-- Page Header -->
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Reservation Dashboard"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>
                <Label text="Search available flights and make a reservation."
                       style="-fx-text-fill: #6c757d;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10">
                <Button fx:id="btnAddFlight"
                        text="+ Add Flight"
                        onAction="#handleAddFlight"
                        styleClass="primary-button"
                        style="-fx-background-color: #003366; -fx-padding: 8 16;"/>
                <Button fx:id="btnEditFlight"
                        text="✎ Edit Flight"
                        onAction="#handleEditFlight"
                        styleClass="secondary-button"
                        style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-text-fill: #334155; -fx-padding: 8 16;"/>
                <Button fx:id="btnDeleteFlight"
                        text="🗑 Delete"
                        onAction="#handleDeleteFlight"
                        styleClass="secondary-button"
                        style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA; -fx-text-fill: #DC2626; -fx-padding: 8 16;"/>
                <Button text="&#8635; Refresh"
                        onAction="#handleClear"
                        styleClass="secondary-button"
                        style="-fx-background-color: #E2E8F0; -fx-border-color: transparent;"/>
            </HBox>
        </HBox>

        <!-- Flight Search &amp; Table Card -->
        <VBox styleClass="booking-card" spacing="20" VBox.vgrow="ALWAYS">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <Label text="Flight Search &amp; Reservations"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #003366;"/>

            <!-- Search Bar Row -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Departure City" styleClass="field-label"/>
                    <TextField fx:id="departureSearch"
                               promptText="Colombo (CMB)"
                               styleClass="input-field"
                               prefWidth="250"/>
                </VBox>
                <Label text="&#8644;"
                       style="-fx-font-size: 20px; -fx-text-fill: #1CA1F2; -fx-padding: 20 0 0 0;"/>
                <VBox spacing="5">
                    <Label text="Arrival City" styleClass="field-label"/>
                    <TextField fx:id="arrivalSearch"
                               promptText="Dubai (DXB)"
                               styleClass="input-field"
                               prefWidth="250"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="" />
                    <HBox spacing="10">
                        <Button text="Search Flights"
                                onAction="#handleSearch"
                                styleClass="primary-button"
                                style="-fx-padding: 10 25 10 25;"/>
                        <Button text="Clear"
                                onAction="#handleClear"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Hint above the table -->
            <Label fx:id="lblSelectHint"
                   text="&#128071;  Click any row below to select a flight, then click Book Selected Flight"
                   style="-fx-font-size: 12px; -fx-text-fill: #1CA1F2;
                          -fx-background-color: #EBF8FF; -fx-background-radius: 6;
                          -fx-padding: 8 14 8 14;"/>

            <!-- Flights Table -->
            <TableView fx:id="flightTable"
                       prefHeight="300.0"
                       styleClass="table-view, clean-table"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        prefWidth="60.0"  text="ID"/>
                    <TableColumn fx:id="colAirline"   prefWidth="200.0" text="Airline"/>
                    <TableColumn fx:id="colDeparture" prefWidth="140.0" text="Departure"/>
                    <TableColumn fx:id="colArrival"   prefWidth="140.0" text="Arrival"/>
                    <TableColumn fx:id="colTime"      prefWidth="170.0" text="Date &amp; Time"/>
                    <TableColumn fx:id="colPrice"     prefWidth="100.0" text="Price ($)"/>
                    <TableColumn fx:id="colSeats"     prefWidth="90.0"  text="Seats Left"/>
                </columns>
                <placeholder>
                    <Label text="No flights found. Try different search terms."
                           style="-fx-text-fill: #6c757d;"/>
                </placeholder>
            </TableView>

            <!-- Action Row: selection status + book button -->
            <HBox alignment="CENTER_LEFT" spacing="20">

                <!-- Selected flight info panel -->
                <HBox fx:id="selectedFlightPanel"
                      alignment="CENTER_LEFT"
                      spacing="12"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #F0FDF4; -fx-background-radius: 8;
                             -fx-padding: 10 16 10 16; -fx-border-color: #86EFAC;
                             -fx-border-radius: 8; -fx-border-width: 1;"
                      visible="false" managed="false">
                    <Label text="&#10003;" style="-fx-text-fill: #22C55E; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <VBox spacing="2">
                        <Label text="SELECTED FLIGHT"
                               style="-fx-font-size: 10px; -fx-text-fill: #15803D; -fx-font-weight: bold;"/>
                        <Label fx:id="lblSelectedFlight"
                               text=""
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0A192F;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSelectedPrice"
                           text=""
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #15803D;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Book button — disabled until a row is selected -->
                <Button fx:id="btnBook"
                        text="Book Selected Flight &#8594;"
                        onAction="#handleBookFlight"
                        styleClass="success-button"
                        disable="true"
                        style="-fx-background-color: #94A3B8; -fx-opacity: 0.75;"/>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>