<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="768.0" prefWidth="1200.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.airline.controller.MainController">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- LEFT SIDEBAR                                    -->
    <!-- ═══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220.0" spacing="4.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" top="28.0" />
            </padding>

            <!-- Brand -->
            <VBox spacing="3.0" style="-fx-padding: 0 0 24 25;">
                <Label styleClass="brand-title" text="SkyLink Pro" />
                <Label fx:id="lblPortalSubtitle" styleClass="brand-subtitle" text="✈  Portal" />
            </VBox>

            <!-- Section label -->
            <Label text="MAIN MENU"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #3d4d6b;
                          -fx-padding: 0 0 4 30; -fx-letter-spacing: 1;"/>

            <!-- Nav Buttons -->
            <VBox spacing="2.0" style="-fx-padding: 0 12 0 12;">
                <Button fx:id="btnDashboard"
                        alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        onAction="#showDashboard"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn, sidebar-btn-active"
                        text="  &#128196;  Dashboard">
                </Button>
                <Button fx:id="btnBookings"
                        alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        onAction="#showBookings"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn"
                        text="  &#128203;  Bookings">
                </Button>
                <Button fx:id="btnAnalytics"
                        alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        onAction="#showAnalytics"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn"
                        text="  &#128200;  Flight Analytics">
                </Button>
                <Button fx:id="btnSettings"
                        alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        onAction="#showSettings"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn"
                        text="  &#9881;  Settings">
                </Button>
            </VBox>

            <!-- Spacer -->
            <VBox VBox.vgrow="ALWAYS" />

            <!-- Bottom section -->
            <Label text="OTHER"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #3d4d6b;
                          -fx-padding: 0 0 4 30;"/>

            <VBox spacing="2.0" style="-fx-padding: 0 12 0 12;">
                <Button alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn"
                        text="  &#128222;  Support">
                </Button>
                <Button alignment="BASELINE_LEFT"
                        mnemonicParsing="false"
                        onAction="#handleLogout"
                        prefHeight="44.0"
                        prefWidth="196.0"
                        styleClass="sidebar-btn-logout"
                        text="  &#128682;  Log Out">
                </Button>
            </VBox>

            <VBox style="-fx-padding: 0 0 8 0;"/>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- CENTER: TOP BAR + DYNAMIC CONTENT              -->
    <!-- ═══════════════════════════════════════════════ -->
    <center>
        <VBox>

            <!-- TOP BAR (clean — no nav tabs) -->
            <HBox alignment="CENTER_LEFT"
                  prefHeight="64.0"
                  spacing="16.0"
                  style="-fx-background-color: #FFFFFF;
                         -fx-padding: 0 28 0 28;
                         -fx-border-color: #E2E8F0;
                         -fx-border-width: 0 0 1 0;">

                <!-- Dynamic Page Title updated by MainController -->
                <Label fx:id="lblPageTitle"
                       text="&#9992;  Reservation Control"
                       style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #003366;"/>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Right: Notification + Profile -->
                <HBox alignment="CENTER" spacing="18.0">

                    <!-- Notification bell -->
                    <Label style="-fx-font-size: 20px; -fx-cursor: hand;"
                           text="&#128276;"/>

                    <!-- Divider -->
                    <Label style="-fx-text-fill: #E2E8F0; -fx-font-size: 22px;" text="|"/>

                    <!-- User info -->
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="lblUserName"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0A192F;"
                               text="Admin User" />
                        <Label fx:id="lblUserRole"
                               style="-fx-font-size: 10px; -fx-text-fill: #1CA1F2; -fx-font-weight: bold;"
                               text="ADMIN" />
                    </VBox>

                    <!-- Avatar circle -->
                    <Label fx:id="lblAvatar"
                           style="-fx-background-color: #1CA1F2; -fx-text-fill: white;
                                  -fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-min-width: 38; -fx-min-height: 38;
                                  -fx-background-radius: 19;
                                  -fx-alignment: center;"
                           text="A"/>
                </HBox>

            </HBox>

            <!-- DYNAMIC PAGE CONTENT -->
            <StackPane fx:id="contentArea"
                       style="-fx-background-color: #F4F7F6;"
                       VBox.vgrow="ALWAYS" />
        </VBox>
    </center>

</BorderPane>
