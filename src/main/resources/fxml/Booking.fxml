<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="500.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.airline.controller.PassengerController">
   <children>
      <VBox layoutX="40.0" layoutY="30.0" prefHeight="480.0" prefWidth="420.0" spacing="15.0">
         <children>
            <Label text="Passenger Data Capture" textFill="#003366">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label fx:id="lblFlightDetails" text="Booking Flight: [Flight Info]" textFill="#555555" />
            
            <Label text="Title &amp; Full Name (As in Passport):" />
            <AnchorPane prefHeight="30.0" prefWidth="420.0">
               <children>
                  <ComboBox fx:id="comboTitle" layoutY="2.0" prefWidth="80.0" promptText="Title" />
                  <TextField fx:id="txtFullName" layoutX="90.0" layoutY="2.0" prefHeight="25.0" prefWidth="330.0" promptText="JOHN DOE" />
               </children>
            </AnchorPane>

            <Label text="Date of Birth:" />
            <DatePicker fx:id="dateDOB" prefWidth="420.0" promptText="Select Date" />

            <Label text="Passport / NIC Number:" />
            <TextField fx:id="txtPassport" promptText="e.g., N12345678" />

            <Label text="Nationality:" />
            <TextField fx:id="txtNationality" promptText="e.g., Sri Lankan" />

            <Label text="Contact Email:" />
            <TextField fx:id="txtEmail" promptText="passenger@email.com" />

            <Label text="Phone Number:" />
            <TextField fx:id="txtPhone" promptText="+94 7X XXX XXXX" />

            <AnchorPane prefHeight="60.0" prefWidth="420.0">
               <children>
                  <Button layoutX="220.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleConfirm" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirm &amp; Generate PNR" />
                  <Button layoutX="100.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #003366; -fx-text-fill: #003366;" text="Cancel" />
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
</AnchorPane>